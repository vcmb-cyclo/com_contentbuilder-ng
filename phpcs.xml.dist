<?xml version="1.0"?>
<ruleset name="ContentBuilderNG">
    <description>PSR-12 coding standard for ContentBuilder NG (Joomla 6 / PHP 8.4 development target).</description>

    <file>admin/src</file>
    <file>admin/layouts</file>
    <file>admin/services</file>
    <file>site/src</file>
    <file>site/layouts</file>
    <file>plugins</file>
    <file>script.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>

    <!--
        Legacy surface inherited from ContentBuilder/BreezingForms, queued for
        decomposition in REFACTORING_PLAN.md chapters D, E and F. Sniffing it
        today yields thousands of findings and drowns new work. Remove entries
        here as each file is refactored.

        Top-level exclude-pattern on purpose: nesting these inside
        <rule ref="PSR12"> alongside a bare <rule ref="PSR12"/> silently
        re-includes everything.
    -->
    <exclude-pattern>admin/src/types/*</exclude-pattern>
    <exclude-pattern>site/src/Model/EditModel.php</exclude-pattern>
    <exclude-pattern>site/src/Model/ListModel.php</exclude-pattern>
    <exclude-pattern>site/src/View/Details/HtmlView.php</exclude-pattern>
    <exclude-pattern>admin/src/Model/VerifyModel.php</exclude-pattern>
    <exclude-pattern>plugins/content/contentbuilderng_download/*</exclude-pattern>
    <exclude-pattern>plugins/content/contentbuilderng_image_scale/*</exclude-pattern>
    <exclude-pattern>plugins/contentbuilderng_themes/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!--
        Permanent, not legacy debt: Joomla routes a controller task to the
        method whose name matches the "task" URL segment literally
        (task=user.verified_view -> UsersController::verified_view()).
        Renaming these to camelCase breaks routing for every bookmarked link
        and third-party integration unless paired with routing aliases, which
        is out of scope for a style pass. Scoped to controllers only: the
        same convention elsewhere in the codebase is real debt and stays
        flagged.
    -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>admin/src/Controller/*</exclude-pattern>
        <exclude-pattern>site/src/Controller/*</exclude-pattern>

        <!--
            ContentbuilderngHelper::is_internal_path() and
            ::contentbuilderng_wordwrap() are invoked by string method name
            through TemplateRenderService::callContentbuilderngHelper()
            ($helperClass::$method(...)), not just by direct ::name() calls.
            A rename here is invisible to grep-for-callers and to PHPStan,
            and is_internal_path() is a security-relevant path-containment
            check (see REFACTORING_PLAN.md chapter F) — silently breaking it
            via a missed string literal is a worse outcome than the naming
            warning. Renaming these belongs in chapter F, alongside removing
            the dynamic dispatch itself, not in a mechanical style pass.
        -->
        <exclude-pattern>admin/src/Helper/ContentbuilderngHelper.php</exclude-pattern>
    </rule>

    <!--
        script.php's install/update class is instantiated by Joomla's
        installer via a fixed name convention: "<element>InstallerScript"
        in the global namespace, resolved by class_exists() against that
        literal string — there is no autoloading path or manifest hook that
        would let a namespaced or PascalCase class be found instead.
        Renaming or namespacing it breaks install/update, it doesn't fix a
        style issue.
    -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>script.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>script.php</exclude-pattern>
    </rule>
</ruleset>
